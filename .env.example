# ============================================================================
# Anti-Gravity GSM Automator - Environment Variables (.env)
# Copy this file to `.env` and fill in environment-specific secrets.
# ============================================================================

# GSM Portal URLs
GSM_PORTAL_BASE_URL=https://gsm.company.internal
GSM_DASHBOARD_URL=https://gsm.company.internal/incidents/unassigned

# Persistent Browser Profile Directory (preserves SSO / MFA cookies)
GSM_BROWSER_USER_DATA_DIR=./browser_profile
GSM_HEADLESS=false
GSM_MOCK_MODE=false

# Microsoft Teams Incoming Webhook URLs
TEAMS_INCIDENT_WEBHOOK_URL=https://company.webhook.office.com/webhookb2/YOUR-CHANNEL-WEBHOOK-ID
TEAMS_SUPERVISOR_WEBHOOK_URL=https://company.webhook.office.com/webhookb2/YOUR-SUPERVISOR-WEBHOOK-ID

# Shift Supervisor Fallback Contact (for Roster Mismatches / Critical Alerts)
SUPERVISOR_NAME=Duty Manager
SUPERVISOR_UPN=duty.manager@company.com

# File Paths Override (Optional - defaults in config.yaml)
ROSTER_FILE_PATH=./data/shift_roster.xlsx
TRACKER_FILE_PATH=./data/GSM_Incident_Tracker.xlsx
LOG_FILE_PATH=./logs/gsm_automation.log
